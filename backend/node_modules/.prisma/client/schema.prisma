// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String       @id @default(uuid())
  mssv        String       @unique
  fullName    String
  email       String       @unique
  enrollments Enrollment[]
  schedules   Schedule[] // Liên kết lịch học cá nhân của sinh viên
}

model Course {
  id          String       @id @default(uuid())
  code        String       @unique // Mã môn học (Ví dụ: INT1301)
  name        String // Tên môn học (Ví dụ: Nhập môn lập trình)
  credits     Int // Số tín chỉ (Ví dụ: 3)
  semester    String       @default("Học kỳ 1 - Năm học 2026-2027") // Học kỳ của môn học
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  schedules   Schedule[] // Liên kết tới bảng lịch học
}

model Schedule {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String? // ID sinh viên (nếu sinh viên tự đăng ký lịch cá nhân)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date      String  @default("2026-09-28") // Ngày cụ thể (YYYY-MM-DD)
  dayOfWeek String // Ví dụ: "Thứ 2", "Thứ 3", ...
  session   String  @default("Sáng") // "Sáng" hoặc "Chiều"
  period    String // Ví dụ: "Tiết 1-3"
  room      String // Phòng học hoặc Link Online
  isOnline  Boolean @default(false) // Hình thức Online hay Offline
  type      String  @default("Lý thuyết") // "Lý thuyết", "Thực hành", hoặc "Thi"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId]) // Đảm bảo 1 sinh viên không đăng ký trùng 1 môn
}
